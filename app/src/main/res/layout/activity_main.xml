<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.lphlinh.adas.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Bảng HUD thông số góc trên bên trái -->
    <LinearLayout
        android:layout_width="450dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="#CC111822"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TỐC ĐỘ: 50 km/h (MÔ PHỎNG)"
            android:textColor="#00FFCC"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLawDist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="LUẬT ĐỊNH (TT 31): >= 27.8 m"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="KHOẢNG CÁCH XE TRƯỚC: -- m"
            android:textColor="#00FF66"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#3300FF66"
            android:gravity="center"
            android:padding="6dp"
            android:text="AN TOÀN"
            android:textColor="#00FF66"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Nút điều khiển nhanh góc dưới bên phải -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnSpeedDown"
            android:layout_width="65dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="-10" />

        <Button
            android:id="@+id/btnSpeedUp"
            android:layout_width="65dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="+10" />

        <Button
            android:id="@+id/btnRain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="MƯA: TẮT" />

        <Button
            android:id="@+id/btnSwitchCam"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ĐỔI CAM" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
